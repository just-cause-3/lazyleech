# ==========================================
# REQUIRED VARIABLES
# ==========================================
# Get these from https://my.telegram.org/
API_ID=1234567
API_HASH=your_api_hash_here

# Get this from @BotFather
BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ

# ==========================================
# OPTIONAL: CHAT SETTINGS
# ==========================================
# Space-separated list of chat IDs where admins can use admin commands
ADMIN_CHATS=-1000000000000

# Space-separated list of chat IDs where everyone can use the bot
EVERYONE_CHATS=-1000000000001

# ==========================================
# OPTIONAL: DOWNLOAD SETTINGS
# ==========================================
# Timeout for torrent downloads (in seconds)
# LEECH_TIMEOUT=300

# Timeout for magnet resolution (in seconds)
# MAGNET_TIMEOUT=60

# Delay between status message updates (in seconds)
# PROGRESS_UPDATE_DELAY=5

# Set to 0 to download padding files, 1 to ignore them
# IGNORE_PADDING_FILE=1

# Maximum number of concurrent upload workers
# MAX_CONCURRENT_UPLOADS=3

# Automatically move a persistently slow Bunkr file to the bottom of its album queue.
# Set the speed threshold to 0 or max skips to 0 to disable automatic skipping.
# BUNKR_SLOW_SPEED_KBPS=650
# BUNKR_SLOW_GRACE_SECONDS=60
# BUNKR_SLOW_DURATION_SECONDS=90
# BUNKR_MAX_AUTO_SKIPS=2

# Conservative Bunkr/CDN connection profile. Files moved down the queue retry
# with the recovery profile, and only this many files run per CDN host.
# BUNKR_CONNECTIONS=4
# BUNKR_RECOVERY_CONNECTIONS=1
# BUNKR_MAX_DOWNLOADS_PER_HOST=4
# BUNKR_SLOW_HOST_COOLDOWN_SECONDS=300

# Secret token for Aria2 RPC (auto-generated if left empty)
# ARIA2_SECRET=your_secret_token

# ==========================================
# OPTIONAL: EXTERNAL PLUGINS
# ==========================================
# MongoDB Connection String (enables persistent Bunkr sessions and RSS)
# DB_URL=mongodb+srv://user:pass@cluster.mongodb.net/

# Mongo database used by LazyLeech collections (keeps compatibility with RSS)
# LAZYLEECH_DB_NAME=ASWFeed

# Custom Nyaa RSS feed link for auto-downloads
# NYAA_RSS_LINKS=https://nyaa.si/?page=rss

# Terabox Download API Key (Get from xAPIverse)
# XAPIVERSE_KEY=sk_your_xapiverse_key_here

# Mega-Debrid (https://www.mega-debrid.eu/) - Premium account required
# Either set an API token directly:
# MEGADEBRID_TOKEN=your_megadebrid_token_here
# Or set login/password so the bot can fetch/refresh tokens itself:
# MEGADEBRID_LOGIN=your_megadebrid_login
# MEGADEBRID_PASSWORD=your_megadebrid_password
# Max time to wait for Mega-Debrid to cache a torrent (in seconds)
# MEGADEBRID_TORRENT_TIMEOUT=3600
